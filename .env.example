NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
# text-to-Cypher (Gemini через OpenAI-сумісний API)
OPEN_API_SECRET_KEY=your_api_key_here
T2C_MODEL=gemini-3.8-flash
# необов'язково (Enterprise/Aura): окремий read-only користувач, див. import/05_readonly_role.cypher
T2C_USER=
T2C_PASSWORD=

# --- ЛР 11: REST API (ключі не коммітьте; мінімум 16 символів, напр. python -c "import secrets;print(secrets.token_urlsafe(24))")
API_KEY_PUBLIC=
API_KEY_ANALYST=
RATE_LIMIT_PER_MIN=10

# --- ЛР 11: LLM-суддя для faithfulness (необов'язково; інша модель, ніж генератор; OpenAI-сумісний API)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
JUDGE_MODEL=

# --- Генератор відповідей: OpenAI-сумісний API (url, модель, ключ)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_TOKENS=300

# --- ЛР 11: параметри RAG (Результат 5)
RAG_TOP_K=5
RAG_PROMPT=rag_v1
RAG_STRICT_CITATIONS=1
